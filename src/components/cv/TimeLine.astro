---
interface Props {
  title: string;
  subtitle?: string;
  startDate?: string; // ISO date, e.g. "2025-07"
  endDate?: string; // ISO date, omit for a current role
}

const { title, subtitle, startDate, endDate } = Astro.props;

const fmt = (iso: string) =>
  iso.length === 4
    ? iso
    : new Date(iso).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        timeZone: "UTC",
      });
---

<article class="tl-item">
  <h3 class="tl-title">{title}</h3>
  <div class="tl-body">
    <span class="tl-sub">
      {
        startDate && (
          <>
            <time datetime={startDate}>{fmt(startDate)}</time>
            {" → "}
            {endDate ? (
              <time datetime={endDate}>{fmt(endDate)}</time>
            ) : (
              "Present"
            )}
            {subtitle && " · "}
          </>
        )
      }
      {subtitle}
    </span>
    <div class="tl-desc">
      <slot />
    </div>
  </div>
</article>
