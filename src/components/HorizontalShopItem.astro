---
const {
  title,
  img,
  desc,
  url,
  badge,
  pricing,
  oldPricing,
  checkoutUrl,
  details = true,
  custom_link = false,
  custom_link_label = "",
} = Astro.props;
---

<div class="tui-card">
  <a href={url}>
    <div class="tui-card-head">
      <span>{title}</span>
      {badge && <span class="tui-badge">{badge}</span>}
    </div>
    <div class="tui-card-body">
      {
        img && (
          <img src={img} alt={title} class="tui-card-img" loading="lazy" />
        )
      }
      <div class="grow w-full">
        <div>
          <span class="text-xl mr-2">{pricing}</span>
          <span class="line-through opacity-50">{oldPricing}</span>
        </div>
        <p class="tui-card-desc">{desc}</p>
      </div>
    </div>
  </a>
</div>
