---
interface Props {
  title: string;
  img?: string;
  desc?: string;
  url: string;
  badge?: string | string[];
  tags?: string[];
  target?: string;
}

const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
const badges = Array.isArray(badge)
  ? badge
  : typeof badge === "string" && badge.length > 0
  ? badge.split(",").map((b) => b.trim())
  : [];
---

<div class="tui-card">
  <a href={url} target={target}>
    <div class="tui-card-head">
      <span>{title}</span>
      {badges.map((b) => <span class="tui-badge">{b}</span>)}
    </div>
    <div class="tui-card-body">
      {
        img && (
          <img src={img} alt={title} class="tui-card-img" loading="lazy" />
        )
      }
      <div class="grow w-full">
        <p class="tui-card-desc">{desc}</p>
        {
          tags && (
            <div class="tui-tags">
              {tags.map((tag) => (
                <span class="tui-tag">#{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </a>
</div>
