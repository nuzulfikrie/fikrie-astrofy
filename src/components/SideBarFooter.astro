---
import { configDev } from "../siteConstants/siteSettings";
---

<div class="social-icons">
  <a
    href={configDev.githubLink}
    target="_blank"
    aria-label="Github"
    title="Github">[github]</a
  >
  <a href={configDev.xLink} target="_blank" aria-label="X" title="X">[x]</a>
  <a
    href={configDev.linkedInLink}
    target="_blank"
    aria-label="Linkedin"
    title="Linkedin">[linkedin]</a
  >
  <a
    href={configDev.tiktokLink}
    target="_blank"
    aria-label="TikTok"
    title="TikTok">[tiktok]</a
  >
</div>
