---
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  description: string;
  updatedDate: Date;
  heroImage?: ImageMetadata;
  pricing?: string;
  oldPricing?: string;
  checkoutUrl?: string;
  badge?: string;
  custom_link?: string;
  custom_link_label?: string;
}

const {
  title,
  description,
  updatedDate,
  heroImage,
  pricing,
  oldPricing,
  checkoutUrl,
  badge,
  custom_link,
  custom_link_label,
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = dayjs(updatedDate).format("ll");
---

<BaseLayout title={title} description={description} image={heroImage?.src}>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {
        heroImage && (
          <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />
        )
      }
      <div class="">
        <h1 class="title my-2 text-4xl font-bold">
          {title}
          {badge && <span class="tui-badge mx-2">{badge}</span>}
        </h1>
        <div class="flex place-content-between items-center">
          <div class="grow md:grow-0">
            <span class="text-xl mr-1"> {pricing}</span>
            <span class="text-md opacity-50 line-through">{oldPricing}</span>
          </div>
          <div>
            {
              custom_link && (
                <a class="tui-btn grow md:grow-0 ml-4" href={custom_link} target="_blank">
                  [ {custom_link_label} ]
                </a>
              )
            }
            <a class="tui-btn tui-btn-primary grow md:grow-0 ml-4" href={checkoutUrl} target="_blank">[ buy now ]</a>
          </div>
        </div>
      </div>
      <div class="tui-hr" aria-hidden="true">{"─".repeat(120)}</div>
      <slot />
    </article>
  </main>
</BaseLayout>
