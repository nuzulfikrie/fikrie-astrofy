---
import PolicyLayout from "../layouts/PolicyLayout.astro";
import { business } from "../siteConstants/business";
---

<PolicyLayout
  title="Contact"
  description="Business name, SSM registration number, address and contact details."
  showUpdated={false}
>
  <p>
    For project enquiries, quotations, invoices, refunds or privacy requests,
    get in touch using the details below.
  </p>

  <table>
    <tbody>
      <tr><th scope="row">Business name</th><td>{business.name}</td></tr>
      <tr><th scope="row">SSM registration no.</th><td>{business.ssmNo}</td></tr>
      <tr><th scope="row">Business address</th><td>{business.address}</td></tr>
      <tr>
        <th scope="row">Phone</th>
        <td>{business.phone}</td>
      </tr>
      <tr>
        <th scope="row">Email</th>
        <td><a href={`mailto:${business.email}`}>{business.email}</a></td>
      </tr>
      <tr><th scope="row">Business hours</th><td>{business.hours}</td></tr>
    </tbody>
  </table>

  <p>
    We aim to reply to all messages within 2 business days. Messages received
    outside business hours or on Malaysian public holidays are answered on the
    next business day.
  </p>

  <h2>Related policies</h2>
  <ul>
    <li><a href="/refund-policy">Refund Policy</a></li>
    <li><a href="/privacy-policy">Privacy Policy</a></li>
    <li><a href="/shipping-policy">Delivery &amp; Return Policy</a></li>
  </ul>
</PolicyLayout>
