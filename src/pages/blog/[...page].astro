---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { configDev } from "../../siteConstants/siteSettings";

export async function getStaticPaths({ paginate }) {
  let apiUrl = `https://dev.to/api/articles?username=${configDev.devtoUsername}`;
  let posts = [];
  try {
    const response = await fetch(apiUrl);
    posts = await response.json();
    posts.sort((a, b) => b.published_at.localeCompare(a.published_at));
  } catch (e) {
    console.warn("Could not fetch dev.to articles at build time:", e.message);
  }
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog" sideBarActiveItemID="blog">
  <div class="tui-section">
    <span>blog</span>
  </div>

  {
    page.data.length === 0 ? (
      <div class="tui-notice">
        <p class="font-bold">Sorry!</p>
        <p>There are no blog posts to show at the moment. Check back later!</p>
      </div>
    ) : (
      <ul class="list-none p-0 m-0">
        {page.data.map((post) => (
          <HorizontalCard
            title={post.title}
            img={post.social_image}
            desc={post.description}
            url={post.canonical_url}
            badge={post.tags}
            target="_self"
          />
        ))}
      </ul>
    )
  }

  <div class="flex justify-between my-10">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="tui-btn">
          {"[<- recent posts]"}
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="tui-btn">
          {"[older posts ->]"}
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
