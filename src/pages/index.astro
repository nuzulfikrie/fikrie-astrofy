---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { configDev } from "../siteConstants/siteSettings";
import projectsData from "../data/projects.json";
import type { DevToArticle } from "../types";
let apiUrl = `https://dev.to/api/articles?username=${configDev.devtoUsername}`;

interface Project {
  title: string;
  img: string;
  desc: string;
  url: string;
  is_foss?: boolean;
}

// projects.json currently ships empty, so its inferred type is never[]
const projects: Project[] = projectsData;

let last_posts: DevToArticle[] = [];
try {
  const response = await fetch(apiUrl);
  const posts: DevToArticle[] = await response.json();
  posts.sort((a, b) => b.published_at.localeCompare(a.published_at));
  last_posts = posts.slice(0, 3);
} catch (e) {
  console.warn(
    "Could not fetch dev.to articles at build time:",
    e instanceof Error ? e.message : e,
  );
}
---

<BaseLayout sideBarActiveItemID="home">
  <div class="tui-window mb-10 mt-5">
    <div class="tui-window-bar">
      <span>guest@fikriesalam.dev: ~</span>
      <span>bash — 80x24</span>
    </div>
    <div class="tui-window-body">
      <p class="tui-cmd"><span class="ps1">$</span> whoami</p>
      <p class="tui-out name">{configDev.developerName}</p>
      <p class="tui-cmd"><span class="ps1">$</span> cat role.txt</p>
      <p class="tui-out role">{configDev.role}</p>
      <p class="tui-cmd"><span class="ps1">$</span> echo $LOCATION</p>
      <p class="tui-out">{configDev.location}</p>
      <p class="tui-cmd"><span class="ps1">$</span> cat about.txt</p>
      <p class="tui-out dim">{configDev.descriptionString}</p>
      <p class="tui-cmd">
        <span class="ps1">$</span> <span class="cursor">█</span>
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="tui-btn tui-btn-primary" href={configDev.xLink} target="_blank"
          >[ let's connect on X ]</a
        >
        <a class="tui-btn" href={configDev.githubLink} target="_blank"
          >[ github ]</a
        >
      </div>
    </div>
  </div>

  <div class="tui-section">
    <span>projects i am working on now {"</>"}</span>
  </div>

  <!-- this part loads data from json file located in data folder and then use map to print out -->

  <!-- if empty show no project -->
  {
    projects.length === 0 ? (
      <div class="tui-notice">
        <span class="ps1" style="color: var(--tui-green); font-weight: 700;">
          $
        </span>{" "}
        ls ~/projects
        <br />
        No project to show at the moment .. why not hire me to build one for
        you?
      </div>
    ) : (
      projects.map((project) => (
        <HorizontalCard
          title={project.title}
          img={project.img}
          desc={project.desc}
          url={project.url}
          badge={
            project.is_foss
              ? "FOSS"
              : project.title === "Demo Project 1"
              ? "NEW"
              : ""
          }
        />
      ))
    )
  }

  <div class="tui-section">
    <span>latest from my blog at dev.to</span>
  </div>

  {
    last_posts.map((post) => (
      <HorizontalCard
        title={post.title}
        img={post.social_image}
        desc={post.description}
        url={post.canonical_url}
        badge={post.tags}
        target="_self"
      />
    ))
  }
</BaseLayout>
