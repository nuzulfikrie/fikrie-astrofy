---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" includeSidebar={false}>
  <div class="tui-window max-w-xl mx-auto mt-10">
    <div class="tui-window-bar">
      <span>guest@fikriesalam.dev: ~</span>
      <span>bash — 80x24</span>
    </div>
    <div class="tui-window-body">
      <p class="tui-cmd"><span class="ps1">$</span> cd /this-page</p>
      <p class="tui-out error">
        bash: cd: /this-page: No such file or directory
      </p>
      <p class="tui-cmd"><span class="ps1">$</span> echo $?</p>
      <p class="tui-out big">404</p>
      <p class="tui-out dim mb-6">
        The page you're looking for couldn't be found.
      </p>
      <a class="tui-btn tui-btn-primary" href="/">[ return home ]</a>
    </div>
  </div>
</BaseLayout>
